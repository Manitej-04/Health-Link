# Copy to backend/.env and replace the placeholders.
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"

FLASK_ENV_NAME=development          # development | production
FLASK_APP=run.py
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ACCESS_MINUTES=120
# Set true when serving over HTTPS (always in production)
JWT_COOKIE_SECURE=false

# Default: SQLite file at backend/instance/healthlink.db
# DATABASE_URL=sqlite:///absolute/path/to/healthlink.db
# Optional MySQL (pip install pymysql):
# DATABASE_URL=mysql+pymysql://healthlink:password@localhost:3306/healthlink

# true: create tables automatically on startup (simple SQLite setup)
# false: manage the schema with migrations:  flask db upgrade
AUTO_CREATE_TABLES=true

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_MB=5
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300

# Application-defined educational risk bands (not clinical thresholds)
RISK_LOW_MAX=0.30
RISK_MODERATE_MAX=0.70

# Windows only, if tesseract.exe is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: create this admin account automatically on startup (if it does not
# exist). Admins can see every patient's assessments and history.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password
# ADMIN_NAME=Administrator
